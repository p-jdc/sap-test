{
	"name": "sap-tests",
	"private": true,
	"scripts": {
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:api:mock": "SAP_API_MOCK=1 playwright test tests/api",
		"test:plugin": "playwright test tests/_plugin",
		"test:demokit": "playwright test tests/fiori/demokit",
		"test:mfs": "MFS_MOCK=1 playwright test tests/_mfs",
		"test:idoc": "IDOC_HUB_MOCK=1 playwright test tests/_idoc",
		"report": "playwright show-report",
		"postinstall": "bun run odata:generate",
		"odata:fetch": "node odata/fetch-metadata.mjs",
		"odata:generate": "generate-odata-client -i odata/metadata -s odata/metadata -o odata/clients --clearOutputDir",
		"codegen": "node recorder/codegen.cjs codegen",
		"record": "node sap-plugin/record.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"mfs:demo": "node mfs/demo.mts",
		"mfs:server": "node mfs/server.mts",
		"idoc:server": "node idoc/server.mts",
		"idoc:certs": "node idoc/certs.mts"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.94.0",
		"@playwright/test": "1.63.0",
		"@sap-cloud-sdk/connectivity": "4.10.0",
		"@sap-cloud-sdk/generator": "4.10.0",
		"@sap-cloud-sdk/odata-v2": "4.10.0",
		"@sap-ux/fe-mockserver-core": "1.8.0",
		"@types/node": "^22.10.0",
		"bignumber.js": "11.1.5",
		"dotenv": "^16.4.7",
		"esbuild": "0.28.2",
		"eslint-plugin-browser-security": "3.1.0",
		"eslint-plugin-secure-coding": "6.1.2",
		"fast-xml-parser": "5.12.1",
		"moment": "2.31.0",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "^5.9.3",
		"xpath": "0.0.34",
		"zod": "4.6.7"
	}
}
