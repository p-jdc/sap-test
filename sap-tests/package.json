{
	"name": "sap-tests",
	"private": true,
	"scripts": {
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:api:mock": "SAP_API_MOCK=1 playwright test tests/api",
		"report": "playwright show-report",
		"postinstall": "bun run odata:generate",
		"odata:fetch": "node odata/fetch-metadata.mjs",
		"odata:generate": "generate-odata-client -i odata/metadata -s odata/metadata -o odata/clients --clearOutputDir",
		"codegen": "node recorder/node_modules/@playwright/test/cli.js codegen",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sap-cloud-sdk/connectivity": "4.10.0",
		"@sap-cloud-sdk/generator": "4.10.0",
		"@sap-cloud-sdk/odata-v2": "4.10.0",
		"@sap-ux/fe-mockserver-core": "1.8.0",
		"@types/node": "^22.10.0",
		"bignumber.js": "11.1.5",
		"dotenv": "^16.4.7",
		"esbuild": "0.28.2",
		"moment": "2.31.0",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "^5.9.3",
		"xpath": "0.0.34"
	}
}
