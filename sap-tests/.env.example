# Copy to .env (never commit .env). Guide §4.2
SAP_URL=https://ihr-testsystem.example.com
SAP_USERNAME=TEST_AUTOMATION
SAP_PASSWORD=bitte-aendern

# Ariba (guide §4.5 / §7.4) – optional. Each system in systems.json has its three variables here.
ARIBA_URL=
ARIBA_USER=
ARIBA_PASS=

# Optional: use an already-installed Chromium instead of `npx playwright install`
# CHROMIUM_PATH=/opt/pw-browsers/chromium

# Optional: an SAP trial system with a self-signed certificate, e.g. a Cloud Appliance Library
# appliance reached by its IP. Host only. The SAP-login systems accept its certificate while
# SAP_URL is on this host; nothing else does (README, "A trial system with a self-signed certificate").
# SAP_SELF_SIGNED_HOST=203.0.113.10

# OData tests (tests/api, sap-plugin/odata.ts) – optional, the tests are skipped without them.
# Host only, no path. They create and change data there: use a development or trial system on
# which the service GWSAMPLE_BASIC is active (/IWFND/MAINT_SERVICE).
SAP_API_URL=
SAP_API_USERNAME=
SAP_API_PASSWORD=
# SAP_CLIENT=002
