{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"overrides": [
		{
			"files": ["*.md"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		},
		{
			"files": ["*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	],
	"ignorePatterns": [
		"package-lock.json",
		"test-results",
		"playwright-report",
		"blob-report",
		"sap-plugin/vendor",
		"tools/oxlint",
		"odata/clients",
		"odata/metadata/options-per-service.json",
		"recorder/node_modules"
	]
}
