{
	"name": "sap-test-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"db:generate": "drizzle-kit generate",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run lint:light && eslint .",
		"format": "oxfmt && prettier --write \"**/*.svelte\"",
		"start": "export HOST=\"${HOST:-127.0.0.1}\"; if [ -f cert/cert.pem ] && [ -f cert/key.pem ]; then export HTTP_2=true TLS_CERT_FILE=cert/cert.pem TLS_KEY_FILE=cert/key.pem; fi; bun build/index.js",
		"test:unit": "bunx --bun vitest",
		"test": "bunx --bun vitest --run",
		"test:e2e": "playwright test",
		"lint:light": "oxlint --type-aware --deny-warnings && oxfmt --check && prettier --check \"**/*.svelte\" && knip",
		"format:check": "oxfmt --check && prettier --check \"**/*.svelte\"",
		"knip": "knip",
		"setup:cert": "bun scripts/setup-cert.ts",
		"test:coverage": "bunx --bun vitest --run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"@rsvelte/oxlint-plugin": "0.2.6",
		"@sveltejs/adapter-bun": "1.0.2",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/browser-playwright": "5.1.1",
		"@vitest/coverage-v8": "5.1.1",
		"drizzle-kit": "0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-browser-security": "3.1.0",
		"eslint-plugin-oxlint": "1.94.0",
		"eslint-plugin-secure-coding": "6.1.2",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"knip": "6.46.1",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"playwright": "1.63.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "5.1.1",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.27",
		"@ui5/webcomponents": "^2.16.0",
		"@ui5/webcomponents-base": "^2.16.0",
		"@ui5/webcomponents-fiori": "^2.16.0",
		"@ui5/webcomponents-icons": "^2.16.0",
		"@xyflow/svelte": "2.0.2",
		"better-auth": "1.7.27",
		"dotenv": "16.6.1",
		"drizzle-orm": "0.45.4",
		"zod": "^4.6.7"
	},
	"patchedDependencies": {
		"@sveltejs/adapter-bun@1.0.2": "patches/@sveltejs%2Fadapter-bun@1.0.2.patch"
	}
}
