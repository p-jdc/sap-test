{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"overrides": [
		{
			"files": ["*.md"],
			"options": { "useTabs": false, "tabWidth": 2 }
		},
		{
			"files": ["*.yml", "*.yaml"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	],
	"ignorePatterns": [
		"bun.lock",
		"package-lock.json",
		"build",
		".svelte-kit",
		"static",
		".data",
		".data-e2e",
		"playwright-report",
		"test-results",
		"*.svelte"
	]
}
