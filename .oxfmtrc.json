{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"overrides": [
		{
			"files": ["*.md"],
			"options": { "useTabs": false, "tabWidth": 2 }
		},
		{
			"files": ["*.yml", "*.yaml"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	],
	"ignorePatterns": [
		"bun.lock",
		"package-lock.json",
		"build",
		".svelte-kit",
		"static",
		".data",
		".data-e2e",
		".data-e2e-auth",
		"playwright-report",
		"test-results",
		"blob-report",
		"coverage",
		"*.svelte",
		// Third-party source kept as it came, and generated files.
		"sap-tests/sap-plugin/vendor",
		"tools/oxlint/anti-slop",
		"sap-tests/odata/clients",
		"sap-tests/odata/metadata/options-per-service.json",
		".claude/mcp",
		// Generated by `bun run agents` and checked by it, not by the formatter.
		".github/agents",
		".codex/agents",
		// Other checkouts of this repository (one per branch), and a person's own Claude Code settings.
		".claude/worktrees",
		".claude/settings.local.json"
	]
}
