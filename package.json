{
	"name": "sap-test",
	"version": "0.0.1",
	"private": true,
	"description": "SAP Test Lab: the SvelteKit app at the root (src/, tests/ for its own browser tests) and the SAP test project in sap-tests/. One install for both. Playwright itself always runs on Node (its CLI's shebang). The Playwright-SAP fork, used to record WebGUI only, is installed under the name playwright-sap-recorder. Its package also declares a `playwright` command, so the scripts start stock Playwright by path (node_modules/@playwright/test/cli.js), never as `playwright`.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"setup": "bun scripts/upgrade-layout.ts && bun install --frozen-lockfile && node node_modules/@playwright/test/cli.js install chromium && bun run setup:recorder",
		"setup:recorder": "${PLAYWRIGHT_NODE:-node} node_modules/playwright-sap-recorder/cli.js install chromium",
		"setup:mcp": "bun install --cwd .claude/mcp --frozen-lockfile",
		"setup:cert": "bun scripts/setup-cert.ts",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "bun run odata:generate",
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"start": "export HOST=\"${HOST:-127.0.0.1}\"; if [ -f cert/cert.pem ] && [ -f cert/key.pem ]; then export HTTP_2=true TLS_CERT_FILE=cert/cert.pem TLS_KEY_FILE=cert/key.pem; fi; bun build/index.js",
		"db:generate": "drizzle-kit generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && tsc -p sap-tests --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run lint:light && eslint .",
		"lint:light": "oxlint --type-aware --deny-warnings && bun run format:check && knip",
		"format": "oxfmt && prettier --write \"**/*.svelte\"",
		"format:check": "oxfmt --check && prettier --check \"**/*.svelte\"",
		"knip": "knip",
		"test": "bunx --bun vitest --run",
		"test:unit": "bunx --bun vitest",
		"test:coverage": "bunx --bun vitest --run --coverage",
		"test:e2e": "node node_modules/@playwright/test/cli.js test",
		"test:sap": "cd sap-tests && node ../node_modules/@playwright/test/cli.js test",
		"test:sap:ui": "cd sap-tests && node ../node_modules/@playwright/test/cli.js test --ui",
		"test:sap:list": "cd sap-tests && node ../node_modules/@playwright/test/cli.js test --list",
		"test:plugin": "cd sap-tests && node ../node_modules/@playwright/test/cli.js test tests/_plugin",
		"test:demokit": "cd sap-tests && node ../node_modules/@playwright/test/cli.js test tests/fiori/demokit",
		"test:mfs": "cd sap-tests && MFS_MOCK=1 node ../node_modules/@playwright/test/cli.js test tests/_mfs",
		"test:idoc": "cd sap-tests && IDOC_HUB_MOCK=1 node ../node_modules/@playwright/test/cli.js test tests/_idoc",
		"test:api:mock": "cd sap-tests && SAP_API_MOCK=1 node ../node_modules/@playwright/test/cli.js test tests/api",
		"report": "cd sap-tests && node ../node_modules/@playwright/test/cli.js show-report",
		"codegen": "cd sap-tests && node recorder/codegen.cjs codegen",
		"record": "cd sap-tests && node sap-plugin/record.mjs",
		"odata:fetch": "cd sap-tests && node odata/fetch-metadata.mjs",
		"odata:generate": "cd sap-tests && generate-odata-client -i odata/metadata -s odata/metadata -o odata/clients --clearOutputDir",
		"mfs:demo": "cd sap-tests && node mfs/demo.mts",
		"mfs:server": "cd sap-tests && node mfs/server.mts",
		"idoc:server": "cd sap-tests && node idoc/server.mts",
		"idoc:certs": "cd sap-tests && node idoc/certs.mts",
		"pregate": "bun scripts/pregate.ts",
		"ci": "bun run check && bun run lint && bun run test && bun run test:sap:list && bun run test:e2e"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.27",
		"@ui5/webcomponents": "^2.16.0",
		"@ui5/webcomponents-base": "^2.16.0",
		"@ui5/webcomponents-fiori": "^2.16.0",
		"@ui5/webcomponents-icons": "^2.16.0",
		"@xyflow/svelte": "2.0.2",
		"better-auth": "1.7.27",
		"dotenv": "16.6.1",
		"drizzle-orm": "0.45.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@oxlint/plugins": "1.94.0",
		"@playwright/test": "1.63.0",
		"@rsvelte/oxlint-plugin": "0.2.6",
		"@sap-cloud-sdk/connectivity": "4.10.0",
		"@sap-cloud-sdk/generator": "4.10.0",
		"@sap-cloud-sdk/odata-v2": "4.10.0",
		"@sap-ux/fe-mockserver-core": "1.8.0",
		"@sveltejs/adapter-bun": "1.0.2",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/browser-playwright": "5.1.1",
		"@vitest/coverage-v8": "5.1.1",
		"bignumber.js": "11.1.5",
		"drizzle-kit": "0.31.11",
		"esbuild": "0.28.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-browser-security": "3.1.0",
		"eslint-plugin-oxlint": "1.94.0",
		"eslint-plugin-secure-coding": "6.1.2",
		"eslint-plugin-svelte": "^3.24.1",
		"fast-xml-parser": "5.12.1",
		"globals": "^17.14.0",
		"knip": "6.46.1",
		"moment": "2.31.0",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"playwright": "1.63.0",
		"playwright-sap-recorder": "npm:@playwright-sap/test@1.1.6",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "5.1.1",
		"vitest-browser-svelte": "3.1.0",
		"xpath": "0.0.34"
	},
	"patchedDependencies": {
		"@sveltejs/adapter-bun@1.0.2": "patches/@sveltejs%2Fadapter-bun@1.0.2.patch",
		"knip@6.46.1": "patches/knip@6.46.1.patch"
	}
}
